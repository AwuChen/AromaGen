# OpenAI
OPENAI_API_KEY=sk-...

# Models (defaults shown)
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini

# AromaGen paths (optional overrides)
# DIALOGUE_LOG_DIR=aromagen/data/dialogue
# LEARNED_EXAMPLES_PATH=aromagen/data/learned_examples.json
# LEARNED_EXAMPLES_ENABLED=true
# LEARNED_EXAMPLES_TOP_K=3

# Composition constraints
# SEQUENCE_TOTAL_SECONDS=30
# SCENT_DURATION_MAX=15

# BLE multi-device sync (optional)
# SYNC_SERVER_URL=ws://localhost:8765
