# OpenAI
OPENAI_API_KEY=sk-...

# Models (defaults shown)
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini

# Self-consistency ensemble for concrete-smell requests (multiple predictor
# calls + a validator pass; see aromagen/agents/openai_client.py). Off by
# default -- single-shot compose for every request when disabled.
# ENSEMBLE_ENABLED=false
# ENSEMBLE_PREDICTOR_COUNT=10
# ENSEMBLE_TEMPERATURE=0.9
# ENSEMBLE_STRONG_THRESHOLD=5
# ENSEMBLE_WEAK_THRESHOLD=3
# ENSEMBLE_RETRY_PREDICTOR_COUNT=5

# AromaGen paths (optional overrides)
# DIALOGUE_LOG_DIR=aromagen/data/dialogue
# LEARNED_EXAMPLES_PATH=aromagen/data/learned_examples.json
# LEARNED_EXAMPLES_ENABLED=true
# LEARNED_EXAMPLES_TOP_K=3

# Composition constraints
# SEQUENCE_TOTAL_SECONDS=30
# SCENT_DURATION_MAX=15
# DESCRIPTOR_FILTER_TOP_K=24

# BLE multi-device sync (optional)
# SYNC_SERVER_URL=ws://localhost:8765

# Pulse-train delivery (hardware playback timing, see aromagen/agents/settings.py)
# PULSE_SECONDS=0.5
# PULSE_ROUNDS=10

# Production interaction logging (frontend "Log" button + "Open Log Sheet").
# OPTIONAL and specific to each installation -- points at a private Google
# Sheet via an Apps Script Web App you deploy yourself. Leave unset and the
# frontend automatically hides the Log/Open-Sheet controls rather than
# erroring; there is no way to point this at someone else's sheet, nor
# should you try to. To set up your own: see
# aromagen/production_logging/apps_script/ (deploy that Apps Script project
# as a Web App, then set these two to your own deployment's exec URL and a
# token of your choosing, matching Code.gs's TOKEN constant).
# INTERACTION_LOG_APPS_SCRIPT_URL=https://script.google.com/macros/s/.../exec
# INTERACTION_LOG_TOKEN=

# Retrieval-augmented composition -- reads the interaction log above (via a
# local JSONL cache, not live from the Sheet) to inform the initial compose
# call with precedent from past sessions. Requires interaction logging to
# have accumulated some data first; has no effect otherwise.
# INTERACTION_RETRIEVAL_ENABLED=false
# INTERACTION_RETRIEVAL_TOP_K=5
# INTERACTION_RETRIEVAL_EMBEDDING_MODEL=text-embedding-3-small

# Relevance validation layer (extra pass after compose, see openai_client.py)
# VALIDATION_LAYER_ENABLED=false
